{% extends 'base.html.twig' %}

{% block title %}Thank you{% endblock %}

{% block body %}
    <div class="w-full h-[90vh] flex justify-center items-center">
        <div class="border-2 border-grey border-solid py-8 pl-4 pr-8 rounded-lg">
            <div class="flex justify-end" data-controller="category">
                <span class="cursor-pointer" data-action="click->category#edit">
                    <svg class="h-6 w-6 text-slate-900"  viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">  <path stroke="none" d="M0 0h24v24H0z"/>  <path d="M9 7 h-3a2 2 0 0 0 -2 2v9a2 2 0 0 0 2 2h9a2 2 0 0 0 2 -2v-3" />  <path d="M9 15h3l8.5 -8.5a1.5 1.5 0 0 0 -3 -3l-8.5 8.5v3" />  <line x1="16" y1="5" x2="19" y2="8" /></svg>
                </span>
                <span class="cursor-pointer" data-action="click->category#add">
                    <svg class="h-6 w-6 text-slate-900"  width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">  <path stroke="none" d="M0 0h24v24H0z"/>  <rect x="4" y="4" width="16" height="16" rx="2" />  <line x1="9" y1="12" x2="15" y2="12" />  <line x1="12" y1="9" x2="12" y2="15" /></svg>
                </span>
                <span class="cursor-pointer" data-action="click->category#delete">
                    <svg class="h-6 w-6 text-red-500"  width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">  <path stroke="none" d="M0 0h24v24H0z"/>  <line x1="4" y1="7" x2="20" y2="7" />  <line x1="10" y1="11" x2="10" y2="17" />  <line x1="14" y1="11" x2="14" y2="17" />  <path d="M5 7l1 12a2 2 0 0 0 2 2h8a2 2 0 0 0 2 -2l1 -12" />  <path d="M9 7v-3a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v3" /></svg>
                </span>
            </div>
            <ul>
                {% for category in categories %}
                    <li class="mb-2" data-controller="category">
                        <div class="flex items-center">
                            <div>
                                <span
                                    class="mr-2 text-xl"
                                    data-category-target="expand"
                                    data-action="click->category#toggle"
                                    data-category-id="{{ category.id }}"
                                    data-category-name="{{ category.name }}"
                                >
                                </span>
                            </div>
                            <span 
                                class="px-2 rounded-xl"
                                data-action="click->category#select"
                                data-category-id="{{ category.id }}"
                                data-category-name="{{ category.name }}"
                            >
                                {{ category.name }}
                            </span>
                        </div>
                        {% if category.children|length > 0 %}
                            <ul class="pl-4 hidden" data-category-target="childList">
                                {% for child in category.children %}
                                    <twig:CategoryTable child="{{ child }}" />
                                {% endfor %}
                            </ul>
                        {% endif %}
                    </li>
                {% endfor %}
            </ul>
        </div>
    </div>
{% endblock %}